rules_version = '2';

// Photos and selfies are private. Browsers and the Firebase SDK get no direct access at all:
// every read and write goes through the API (Cloud Run service account, which bypasses these rules)
// so profile privacy, blocking and moderation checks always apply.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
