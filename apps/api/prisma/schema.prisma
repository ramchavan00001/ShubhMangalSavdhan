// Shubh Mangal Savdhan — database schema (Phase 1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Accounts ───────────────────────────────

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

model User {
  id           String     @id @default(cuid())
  phone        String     @unique // E.164 without "+", e.g. 919876543210
  email        String?    @unique
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  // Bumped to invalidate every issued session ("log out of all devices").
  tokenVersion Int        @default(0)
  lastActiveAt DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Email (verified with a one-time code before we send anything to it)
  emailVerifiedAt    DateTime?
  pendingEmail       String?
  emailCodeHash      String?
  emailCodeExpiresAt DateTime?
  notifyByEmail      Boolean   @default(true)

  // WhatsApp — every flag starts OFF and is only switched on by the member (DPDP consent)
  whatsappDigest       Boolean @default(false) // receive new-match digests
  whatsappShareProfile Boolean @default(false) // appear in other members' digests
  whatsappAlerts       Boolean @default(false) // interest alerts

  profile          Profile?
  subscriptions    Subscription[]
  payments         Payment[]
  notifications    Notification[]
  consents         ConsentLog[]
  whatsappMessages WhatsAppMessage[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ─────────────────────────────── Profiles ───────────────────────────────

enum Gender {
  MALE
  FEMALE
}

enum CreatedFor {
  SELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  RELATIVE
  FRIEND
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
  ANNULLED
}

enum Diet {
  VEG
  NON_VEG
  EGGETARIAN
  JAIN
  VEGAN
}

enum Habit {
  NO
  OCCASIONALLY
  YES
}

enum FamilyType {
  JOINT
  NUCLEAR
}

enum FamilyValues {
  TRADITIONAL
  MODERATE
  LIBERAL
}

enum Manglik {
  NO
  YES
  ANSHIK
  DONT_KNOW
}

enum ProfileStatus {
  DRAFT // wizard not finished
  PENDING // waiting for admin review
  APPROVED
  REJECTED
}

enum PhotoVisibility {
  ALL // every logged-in member
  PREMIUM // premium members only
  ACCEPTED // only members whose interest I accepted / who accepted mine
}

enum ContactVisibility {
  ALLOW_UNLOCK // any member may unlock with a weekly credit
  AFTER_ACCEPT // only after an interest between us is accepted
}

model Profile {
  id     String @id @default(cuid())
  // Human-friendly sequence; the public profile code is "SMS" + (1000000 + seq).
  seq    Int    @unique @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdFor CreatedFor @default(SELF)

  // Step 1 — basic
  firstName     String?
  lastName      String?
  gender        Gender?
  dateOfBirth   DateTime?      @db.Date
  heightCm      Int?
  maritalStatus MaritalStatus?
  religion      String?
  community     String?
  subCaste      String?
  motherTongue  String?
  manglik       Manglik?

  // Step 2 — location
  country     String? @default("India")
  state       String?
  city        String?
  citizenship String? @default("India")

  // Step 3 — education & career
  education    String?
  college      String?
  profession   String?
  company      String?
  annualIncome String? // income band value from master data

  // Step 4 — family
  fatherOccupation String?
  motherOccupation String?
  brothers         Int?
  sisters          Int?
  familyType       FamilyType?
  familyValues     FamilyValues?
  nativePlace      String?

  // Step 5 — lifestyle
  diet     Diet?
  smoking  Habit?
  drinking Habit?

  // Step 6 — about
  aboutMe String? @db.Text

  onboardingStep  Int           @default(1)
  status          ProfileStatus @default(DRAFT)
  rejectionReason String?
  approvedAt      DateTime?

  // Verification badges (badge shows when both are set)
  idVerifiedAt     DateTime?
  selfieVerifiedAt DateTime?

  // Privacy
  hidden            Boolean           @default(false)
  photoVisibility   PhotoVisibility   @default(ALL)
  contactVisibility ContactVisibility @default(ALLOW_UNLOCK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos     Photo[]
  preference PartnerPreference?

  sentInterests     Interest[]      @relation("InterestSender")
  receivedInterests Interest[]      @relation("InterestReceiver")
  marksMade         ProfileMark[]   @relation("MarkOwner")
  marksReceived     ProfileMark[]   @relation("MarkTarget")
  reportsMade       Report[]        @relation("ReportReporter")
  reportsReceived   Report[]        @relation("ReportTarget")
  viewsMade         ProfileView[]   @relation("ViewViewer")
  viewsReceived     ProfileView[]   @relation("ViewViewed")
  unlocksMade       ContactUnlock[] @relation("UnlockOwner")
  unlocksReceived   ContactUnlock[] @relation("UnlockTarget")
  messagesSent      Message[]       @relation("MessageSender")
  messagesReceived  Message[]       @relation("MessageReceiver")
  digestItems       DigestItem[]    @relation("DigestRecipient")
  digestAppearances DigestItem[]    @relation("DigestCandidate")
  digests           Digest[]
  verifications     Verification[]

  @@index([status, hidden, gender])
  @@index([city])
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

model Photo {
  id        String      @id @default(cuid())
  profileId String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileKey   String // storage key (local path in dev, S3 key in production)
  mimeType  String
  isMain    Boolean     @default(false)
  status    PhotoStatus @default(PENDING)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  // AI pre-screening for moderators (empty until an AI key is configured)
  aiRisk      Int? // 0 (fine) – 100 (almost certainly not allowed)
  aiFlags     String[]
  aiCheckedAt DateTime?

  @@index([profileId])
}

// Empty arrays and null bounds mean "any".
model PartnerPreference {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  ageMin          Int?
  ageMax          Int?
  heightMinCm     Int?
  heightMaxCm     Int?
  maritalStatuses MaritalStatus[]
  religions       String[]
  communities     String[]
  motherTongues   String[]
  states          String[]
  cities          String[]
  educations      String[]
  professions     String[]
  diets           Diet[]

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────── Interactions ───────────────────────────────

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Interest {
  id          String         @id @default(cuid())
  senderId    String
  sender      Profile        @relation("InterestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    Profile        @relation("InterestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      InterestStatus @default(PENDING)
  message     String?
  createdAt   DateTime       @default(now())
  respondedAt DateTime?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, createdAt])
}

enum MarkType {
  SHORTLIST
  IGNORE
  BLOCK
}

model ProfileMark {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Profile  @relation("MarkOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    Profile  @relation("MarkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type      MarkType
  createdAt DateTime @default(now())

  @@unique([ownerId, targetId, type])
  @@index([targetId, type])
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   Profile      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String
  target     Profile      @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

model ProfileView {
  id       String   @id @default(cuid())
  viewerId String
  viewer   Profile  @relation("ViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedId String
  viewed   Profile  @relation("ViewViewed", fields: [viewedId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([viewerId, viewedId])
  @@index([viewedId, viewedAt])
}

model ContactUnlock {
  id         String   @id @default(cuid())
  ownerId    String
  owner      Profile  @relation("UnlockOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId   String
  target     Profile  @relation("UnlockTarget", fields: [targetId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([ownerId, targetId])
  @@index([ownerId, unlockedAt])
}

// ─────────────────────────────── Billing ───────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(ACTIVE)
  // The contact-unlock week is counted from startsAt.
  startsAt  DateTime
  endsAt    DateTime
  paymentId String?            @unique
  payment   Payment?           @relation(fields: [paymentId], references: [id])
  note      String? // e.g. "Extended by admin"
  createdAt DateTime           @default(now())

  @@index([userId, endsAt])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "razorpay" or "mock"
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  basePaise         Int
  gstPaise          Int
  totalPaise        Int
  status            PaymentStatus @default(CREATED)
  invoiceNumber     String?       @unique
  // Snapshot of the billing state, used to split GST into CGST+SGST or IGST.
  billingState      String?
  createdAt         DateTime      @default(now())
  paidAt            DateTime?

  subscription Subscription?

  @@index([userId, createdAt])
}

model InvoiceCounter {
  financialYear String @id // e.g. "2026-27"
  lastNumber    Int    @default(0)
}

// ─────────────────────────────── Misc ───────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum MasterType {
  RELIGION
  COMMUNITY
  MOTHER_TONGUE
  EDUCATION
  PROFESSION
  INCOME
  STATE
}

// Dropdown lists managed from the admin panel.
model MasterItem {
  id        String     @id @default(cuid())
  type      MasterType
  value     String
  // For COMMUNITY: the religion it belongs to.
  parent    String?
  sortOrder Int        @default(0)
  active    Boolean    @default(true)

  @@unique([type, value])
  @@index([type, active, sortOrder])
}

// ─────────────────────────────── Phase 2: chat ───────────────────────────────

model Message {
  id         String    @id @default(cuid())
  senderId   String
  sender     Profile   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   Profile   @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String    @db.Text
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
}

// ─────────────────────────────── Phase 2: WhatsApp ───────────────────────────────

/// Append-only record of every consent given or withdrawn (DPDP Act proof).
model ConsentLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // WHATSAPP_DIGEST | WHATSAPP_SHARE_PROFILE | WHATSAPP_ALERTS | EMAIL
  granted   Boolean
  source    String // WEB_SETTINGS | ONBOARDING | WHATSAPP_STOP
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

/// A new member waiting to be included in someone's digest. Each pair is sent at most once.
model DigestItem {
  id          String    @id @default(cuid())
  recipientId String
  recipient   Profile   @relation("DigestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Profile   @relation("DigestCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  digestId    String?
  digest      Digest?   @relation(fields: [digestId], references: [id], onDelete: SetNull)
  position    Int? // 1-based number shown in the message ("Interested 2")
  createdAt   DateTime  @default(now())

  @@unique([recipientId, candidateId])
  @@index([recipientId, digestId])
}

model Digest {
  id          String       @id @default(cuid())
  recipientId String
  recipient   Profile      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  sentAt      DateTime     @default(now())
  items       DigestItem[]

  @@index([recipientId, sentAt])
}

enum MessageDirection {
  OUT
  IN
}

model WhatsAppMessage {
  id                String           @id @default(cuid())
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone             String
  direction         MessageDirection
  kind              String // DIGEST | INTEREST_ALERT | REPLY | INBOUND
  body              String           @db.Text
  status            String // LOGGED (test mode) | SENT | FAILED | RECEIVED
  providerMessageId String?          @unique
  error             String?
  interestId        String? // for interest alerts, so "Accept" knows which one
  createdAt         DateTime         @default(now())

  @@index([phone, createdAt])
  @@index([kind, createdAt])
}

// ─────────────────────────────── Phase 2: verification ───────────────────────────────

enum VerificationType {
  ID
  SELFIE
}

enum VerificationStatus {
  PENDING // waiting for a moderator
  APPROVED
  REJECTED
}

model Verification {
  id         String             @id @default(cuid())
  profileId  String
  profile    Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type       VerificationType
  status     VerificationStatus @default(PENDING)
  provider   String // "mock", "digilocker", "rekognition", "manual"…
  // ID: never the full Aadhaar/PAN number — only type, last 4 and the name on it.
  docType    String?
  docLast4   String?
  nameOnDoc  String?
  // Selfie: stored privately, only moderators can view it.
  fileKey    String?
  score      Float?
  reason     String?
  createdAt  DateTime           @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([profileId, type])
}
