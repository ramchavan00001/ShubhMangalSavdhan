# ── Core ──
NODE_ENV=development
PORT=4000
# Public URL of the website (used in links, CORS and cookies)
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://sms:sms@localhost:5432/sms_dev
# Long random string: openssl rand -hex 32
JWT_SECRET=change-me
# Comma-separated phone numbers (91XXXXXXXXXX) that become admins on login / seed
ADMIN_PHONES=919999999999

# ── OTP / SMS ──
# "console" prints OTPs to the API log (development). "msg91" sends real SMS.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── Payments ──
# "mock" completes payments without Razorpay (development). "razorpay" for real payments.
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Invoices (GST) ──
BUSINESS_NAME=Shubh Mangal Savdhan
BUSINESS_GSTIN=[YOUR GSTIN]
BUSINESS_ADDRESS=[YOUR REGISTERED ADDRESS]
# State of registration; decides CGST+SGST (same state) vs IGST (other state)
BUSINESS_STATE=Maharashtra
# Service accounting code printed on invoices — confirm with your CA
BUSINESS_SAC=[SAC CODE]

# ── WhatsApp ──
# "console" saves and prints messages instead of sending them (development).
# "meta" sends through the WhatsApp Cloud API (needs a verified Meta Business account).
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret, used to verify incoming webhook calls
WHATSAPP_APP_SECRET=
# Any random string; enter the same one in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Approved template names (see README for their exact text)
WHATSAPP_TEMPLATE_DIGEST=new_matches
WHATSAPP_TEMPLATE_INTEREST=interest_received
WHATSAPP_TEMPLATE_LANG=en

# ── Email ──
# "console" prints emails to this log (development). "smtp" sends through any SMTP service
# (Zoho Mail, Google Workspace, Amazon SES, Brevo…).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Shubh Mangal Savdhan <no-reply@yourdomain.in>

# ── AI (Claude) ──
# Leave empty to switch AI features off (bio writer, photo pre-screening, WhatsApp reply fallback).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Verification ──
# "mock" auto-approves an ID when the name on it matches the profile (development only).
# "manual" sends every ID and selfie to moderators (use until a KYC provider is connected).
KYC_PROVIDER=mock

# ── File storage (photos and selfies) ──
# "local": files in UPLOAD_DIR (development). "gcs": a private Cloud Storage / Firebase Storage bucket.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
STORAGE_BUCKET=
STORAGE_PREFIX=uploads/
# Only for a local GCS emulator, e.g. fake-gcs-server:
#   STORAGE_EMULATOR_HOST=http://localhost:4443/storage/v1  and  STORAGE_API_ENDPOINT=http://localhost:4443
STORAGE_API_ENDPOINT=

# ── Daily jobs (plan expiry, WhatsApp digests) ──
# "internal": run inside the API at 09:00 IST (development, one server).
# "external": Cloud Scheduler calls POST /cron/daily-maintenance and /cron/whatsapp-digests with an OIDC token.
SCHEDULER_MODE=internal
# Required when external: the API's public URL and the scheduler's service account
CRON_AUDIENCE=
CRON_INVOKER_EMAIL=
